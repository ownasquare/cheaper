# Where the gateway forwards to (the real Anthropic API by default).
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com

# Routing mode:
#   heuristic = classify from request content, no extra model call (fast, free)
#   triage    = make a cheap Haiku classification call first (closer to the skill,
#               adds one small call per request)
ROUTER_MODE=heuristic

# Concrete model ids each tier maps to. Set these to models enabled on your account.
ROUTER_MODEL_HAIKU=claude-haiku-4-5
ROUTER_MODEL_SONNET=claude-sonnet-4-5
ROUTER_MODEL_OPUS=claude-opus-4-6

# false (default) = requested model is a CEILING: only ever downgrade/match, never
#                   spend more than the caller asked (pure cost saver, no surprises).
# true            = full adaptive: content can push a request ABOVE the requested tier.
ROUTER_ALLOW_UPGRADE=false

# Never route below this tier.
ROUTER_MIN_TIER=haiku

# Requests longer than this many chars are nudged to at least sonnet.
ROUTER_LONG_CHARS=4000

# NOTE: the client still sends its own auth (x-api-key / Authorization). The gateway
# forwards those headers upstream unchanged; it does not store or need its own key.

# --- OpenAI-compatible front-end (for Codex/Cursor/Copilot/… tools) ---
OPENAI_UPSTREAM_URL=https://api.openai.com
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_MID=gpt-4o
OPENAI_MODEL_TOP=o3
